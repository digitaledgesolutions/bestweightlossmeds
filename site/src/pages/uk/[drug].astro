---
import Base from '../../layouts/Base.astro';
import PriceBoard from '../../components/PriceBoard.astro';
import BoardScript from '../../components/BoardScript.astro';
import Faq from '../../components/Faq.astro';
import DoseMatrix from '../../components/DoseMatrix.astro';
import DoseStats from '../../components/DoseStats.astro';
import { DRUGS, DRUG_LIST, listingsFor, doseStats, gbp, doseLabel, gmt, GENERATED_AT, type DrugKey } from '../../lib/data';
import { SHARED_FAQS, DRUG_FAQS } from '../../lib/content';

export function getStaticPaths() {
  return DRUG_LIST.map((d) => ({ params: { drug: d.key } }));
}
const drug = Astro.params.drug as DrugKey;
const d = DRUGS[drug];
const ls = listingsFor(drug);
const years = ls.filter((l) => l.firstYear != null).sort((a, b) => a.firstYear! - b.firstYear!);
const faqs = [...DRUG_FAQS[drug], ...SHARED_FAQS];
const stats = doseStats(drug).filter((s) => s.n > 0);
const site = 'https://bestweightlossmeds.com';
const monthYear = new Date(GENERATED_AT || Date.now()).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
    {
      '@type': 'Dataset', name: `${d.name} prices in the UK by dose`,
      description: `Published ${d.name} (${d.generic}) prices from ${ls.length} UK online pharmacies and clinics at every dose, read from each provider's own website daily.`,
      url: site + d.path, dateModified: GENERATED_AT || undefined, isAccessibleForFree: true, license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: { '@type': 'Organization', name: 'Best Weight Loss Meds', url: site },
      spatialCoverage: 'United Kingdom', variableMeasured: 'Price in GBP per pen or pack, by dose',
      distribution: [
        { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${site}${d.path}prices.csv` },
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${site}/uk/prices.json` },
      ],
    },
  ],
};
---
<Base
  title={`${d.name} prices UK: every dose compared | Best Weight Loss Meds`}
  description={`Compare ${d.name} (${d.generic}) prices from UK providers at every dose from ${doseLabel(d.doses[0])} to ${doseLabel(d.doses.at(-1)!)}. Checked every day.`}
  current={d.path} jsonld={jsonld}>
  <section class="hero">
    <div class="wrap">
      <h1>{d.name} prices UK</h1>
      <p class="lede">{d.form} ({d.generic}) from {ls.length} UK providers, {monthYear}. Pick your dose to see who's cheapest today.</p>
      {GENERATED_AT && <p class="freshbar"><span><span class="dot" aria-hidden="true"></span>Prices checked <strong>{gmt(GENERATED_AT)}</strong></span><span>Next check tomorrow morning</span><a href="#all-doses">See every dose side by side</a></p>}
      {stats.length > 0 && (
        <ul class="quick">
          {[stats[0], stats.at(-1)!].map((s) => <li><span class="muted small">Cheapest {doseLabel(s.dose)}</span><strong>{gbp(s.low!)}</strong><span class="small">{s.lowBy[0].name}{s.lowBy.length > 1 ? ` +${s.lowBy.length - 1}` : ''}</span></li>)}
          <li><span class="muted small">Typical {doseLabel(stats[0].dose)}</span><strong>{gbp(stats[0].median!)}</strong><span class="small">median of {stats[0].n}</span></li>
        </ul>
      )}
      <PriceBoard drug={drug} />
    </div>
  </section>

  <DoseMatrix drug={drug} />
  <DoseStats drug={drug} />

  {years.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Cheapest over the first year</h2>
        <p class="muted measure">The starting dose is the cheapest. What you'll really spend depends on the doses you step up to. These totals assume a common step-up plan; the questions below explain it.</p>
        <table class="dtable" style="max-width:36rem">
          <thead><tr><th scope="col">Provider</th><th scope="col">First-year total</th></tr></thead>
          <tbody>
            {years.slice(0, 8).map((l, i) => (
              <tr>
                <td><a href={`/uk/providers/${l.provider.slug}/`}>{l.provider.name}</a></td>
                <td class="num">{gbp(l.firstYear!, 0)} {i > 0 && <span class="rel">+{gbp(l.firstYear! - years[0].firstYear!, 0)}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <Faq items={faqs} />
  <BoardScript />
</Base>
