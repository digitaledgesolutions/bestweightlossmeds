---
// Homepage. MHRA Blue Guide (Appendix 6): no prescription-only medicine is named on the
// homepage, and no price appears here. Medicine price lists live on inner pages only.
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { liveProviders, priceCount, gmt, GENERATED_AT } from '../../lib/data';
import { HOME_FAQS, METHOD } from '../../lib/content';
const count = liveProviders().length;
---
<Base
  title="Compare UK online weight-management services | Best Weight Loss Meds"
  description="Independent, factual information on UK online weight-management providers: published price lists checked daily, GPhC registration and what to check before a consultation."
  current="/uk/">
  <section class="hero">
    <div class="wrap">
      <h1>Compare UK online weight-management services</h1>
      <p class="lede">Independent, factual information on {count} UK online pharmacies and clinics. We read each provider's published prices every morning, and we never take payment from them.</p>
      {GENERATED_AT && <p class="freshbar"><span><span class="dot" aria-hidden="true"></span>Last checked <strong>{gmt(GENERATED_AT)}</strong></span><span><strong>{priceCount()}</strong> published prices</span><span>No commissions, no paid placements</span></p>}
      <p style="margin-top:1.5rem;display:flex;gap:0.75rem;flex-wrap:wrap">
        <a class="btn btn-solid" href="/uk/price-lists/">See published price lists</a>
        <a class="btn" href="/uk/providers/">Browse providers A to Z</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap cols">
      <div>
        <h2>Treatment starts with a consultation</h2>
        <p class="muted">Weight-management medicines are prescription-only in the UK. Every provider listed here supplies them only after an online consultation with a UK-registered prescriber, who decides whether treatment is suitable for you. They may decide it isn't.</p>
        <p class="muted">Choose a provider on more than price: check its GPhC registration, the aftercare it offers and the terms of any plan before you start.</p>
      </div>
      <div>
        <h2>Before your consultation</h2>
        <ul class="muted">
          <li>Check the pharmacy on the <a href="https://www.pharmacyregulation.org/registers/pharmacy" rel="noopener" target="_blank">GPhC register</a>.</li>
          <li>Ask what's included: consultation, delivery, ongoing reviews.</li>
          <li>Read any plan terms: some providers bill every four weeks.</li>
          <li>Report side effects through the <a href="https://yellowcard.mhra.gov.uk/" rel="noopener" target="_blank">MHRA Yellow Card</a> scheme.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How we check prices</h2>
      <ol class="steps">
        {METHOD.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
      <p style="margin-top:1.5rem"><a href="/uk/how-we-check-prices/">More about our method</a></p>
    </div>
  </section>

  <Faq items={HOME_FAQS} />
</Base>
