---
// One drug's price list. Rows render once on the server with every dose's price in
// data attributes; a tiny script re-sorts them when the dose changes. Without JS the
// list is correct for the starting dose.
import { DRUGS, ranked, listingsFor, recentChange, gbp, doseLabel, checkedAt, hostOf, SOURCE_LABEL, type DrugKey } from '../lib/data';
interface Props { drug: DrugKey; dose?: string; limit?: number; hidden?: boolean; showDoses?: boolean }
const { drug, dose: doseProp, limit = 0, hidden = false, showDoses = false } = Astro.props;
const d = DRUGS[drug];
const dose = doseProp || d.startDose;
const first = ranked(drug, dose).sort((a, b) => a.provider.name.localeCompare(b.provider.name));
const rest = listingsFor(drug).filter((l) => l.prices[dose] == null)
  .sort((a, b) => a.provider.name.localeCompare(b.provider.name));
const rows = [...first, ...rest];
const best = first[0]?.prices[dose];
const ext = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12"/></svg>`;
---
<section class="board" data-board={drug} data-dose={dose} data-limit={limit} hidden={hidden} aria-label={`${d.name} prices`}>
  <p class="notice small" style="margin:0 0 0.75rem"><strong>Prescription-only.</strong> Supplied only after a consultation with a UK-registered prescriber, who may decide it isn't suitable for you. Choose a provider on more than price.</p>
  {showDoses && (
    <div class="doses" role="group" aria-label={`${d.name} dose`}>
      {d.doses.map((x) => <button class="dose" type="button" data-dose={x} aria-pressed={String(x === dose)}>{doseLabel(x)}</button>)}
    </div>
  )}
  <div class="board-meta">
    <span data-count><strong>{first.length}</strong> providers publish a {doseLabel(dose)} price</span>
    <span class="filters">
      <label>Sort <select data-sort><option value="name">Provider A to Z</option><option value="price">Price, low to high</option></select></label>
      <label><input type="checkbox" data-nosub /> Hide subscription-only</label>
    </span>
  </div>
  {rows.length === 0 ? (
    <div class="empty">
      <h3>No verified {d.name} prices right now</h3>
      <p class="muted">We only show prices we've confirmed on the provider's own site in the last 48 hours. The next check runs early tomorrow morning.</p>
    </div>
  ) : (
    <ol class="plist" data-list>
      {rows.map((l, i) => {
        const p = l.prices[dose];
        const isBest = p != null && p === best;
        return (
          <li class="prow" data-row data-p={JSON.stringify(l.prices)} data-w={JSON.stringify(l.wasPrices)} data-sub={l.provider.subscription ? '1' : '0'} hidden={p == null || (limit > 0 && i >= limit)}>
            
            <span class="name"><a href={`/uk/providers/${l.provider.slug}/`}>{l.provider.name}</a></span>
            <span class="meta">
              <span class="src" title={`Read from ${SOURCE_LABEL[l.sourceType]}`}>Price checked <time datetime={l.verifiedAt}>{checkedAt(l.verifiedAt)}</time> on <a href={l.url} rel="nofollow noopener noreferrer" target="_blank">{hostOf(l.url)}</a></span>
              {l.provider.subscription && <span class="chip chip-sub" title="This price needs an ongoing plan or membership">Subscription</span>}
            </span>
            <span class="price">
              <span class="amount" data-amount>{p != null ? gbp(p) : ''}</span>
              <span class="was" data-was hidden={!l.wasPrices[dose]}>{l.wasPrices[dose] ? gbp(l.wasPrices[dose]) : ''}</span>
              <span class="per">{drug === 'wegovy-pill' ? 'per 30 days' : 'per pen, 4 weeks'}</span>
            </span>
            <span class="act">
              <a class="btn" href={l.url} rel="nofollow noopener noreferrer" target="_blank">Visit provider <Fragment set:html={ext} /></a>
              <details class="ladder">
                <summary>All doses</summary>
                <dl class="ladder-grid">
                  {d.doses.filter((x) => l.prices[x] != null).map((x) => <div><dt>{doseLabel(x)}</dt><dd>{gbp(l.prices[x])}</dd></div>)}
                </dl>
              </details>
            </span>
          </li>
        );
      })}
    </ol>
  )}
  {limit > 0 && rows.length > 0 && <p><a class="btn btn-solid" href={d.path} data-more>See all {d.name} prices</a></p>}
</section>
