---
import '../styles/global.css';
interface Props { title: string; description: string; current?: string; jsonld?: object }
const { title, description, current = '', jsonld } = Astro.props;
const nav = [
  { href: '/uk/mounjaro/', label: 'Mounjaro' },
  { href: '/uk/wegovy/', label: 'Wegovy' },
  { href: '/uk/wegovy-pill/', label: 'Wegovy pill' },
  { href: '/uk/providers/', label: 'Providers' },
  { href: '/uk/how-we-check-prices/', label: 'How we check' },
];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to prices</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/uk/" aria-label="Best Weight Loss Meds, home">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path fill="#0e5e52" d="M4 6a3 3 0 0 1 3-3h12.8a3 3 0 0 1 2.1.9l6.2 6.2a3 3 0 0 1 0 4.2L15.3 27.1a3 3 0 0 1-4.2 0L4.9 20.9A3 3 0 0 1 4 18.8z"/><circle cx="10.5" cy="9.5" r="2.6" fill="#ffe14d"/></svg>
        Best Weight Loss Meds
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <nav aria-label="Footer">
        <a href="/uk/how-we-check-prices/">How we check prices</a>
        <a href="/uk/providers/">All providers</a>
        <a href="/uk/privacy/">Privacy</a>
      </nav>
      <p class="measure">Independent UK price comparison. We don't sell medicines, give medical advice or take payment from any provider. Mounjaro and Wegovy are prescription-only: a registered prescriber decides whether they're right for you. Always confirm the final price on the provider's own site.</p>
    </div>
  </footer>
</body>
</html>
